                  ],
                  [
                    "il fait mauvais",
                    "/il fɛ mɔ.vɛ/",
                    "天气差"
                  ],
                  [
                    "il fait chaud",
                    "/il fɛ ʃo/",
                    "热"
                  ],
                  [
                    "il fait froid",
                    "/il fɛ fʁwa/",
                    "冷"
                  ],
                  [
                    "il fait doux",
                    "/il fɛ du/",
                    "温和"
                  ],
                  [
                    "il fait beau temps",
                    "/il fɛ bo tɑ̃/",
                    "天气晴朗"
                  ],
                  [
                    "il pleut",
                    "/il plø/",
                    "下雨"
                  ],
                  [
                    "il neige",
                    "/il nɛʒ/",
                    "下雪"
                  ]
                ]
              }
            },
            {
              "t": "「briller」为什么写成 brille",
              "b": "briller（发光、照耀）是规则的第一组（-er）动词：去掉 -er 再加词尾就行。ils 形式后面多的 -ent 完全不发音，所以 il brille 和 ils brillent 听起来一样。第一组动词占法语动词约九成，把这条规则练熟，动词变位就不再可怕。",
              "conj": {
                "v": "briller",
                "t": "present"
              }
            }
          ],
