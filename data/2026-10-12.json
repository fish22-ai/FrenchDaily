        {
          "id": "s4",
          "text": "Plus j'apprends le français, plus je trouve cette langue belle.",
          "translation": "我越学法语，越觉得这门语言优美。",
          "difficulty": "B1",
          "grammar_note": "plus...plus 是\"越......越......\"结构。cette 是阴性指示形容词\"这个\"，修饰阴性名词 langue。",
          "grammar_notes": {
            "plus": "plus...plus 结构表示越...越...",
            "cette": "阴性单数指示形容词，修饰阴性名词 langue",
            "apprends": "apprendre 的现在时 je 形式（同 prendre 一族）",
            "belle": "beau 的阴性形式，这里放在名词后作「觉得……怎么样」的表语",
            "trouve": "trouver 的现在时 je 形式；trouver + 宾语 + 形容词 = 觉得……如何"
          },
          "grammar_lessons": [
            {
              "t": "plus… plus… 「越……越……」",
              "b": "结构就是两个 plus 各带一件事：Plus + 第一件事 + plus + 第二件事。同族还有 moins…moins…（越不……越不……）和 plus…moins…（越……越不……）。两个 plus 后面都必须跟「主语 + 动词」，不能只跟一个名词。",
              "table": {
                "caption": "三种「越……」结构",
                "head": [
                  "结构",
                  "意思"
                ],
                "rows": [
                  [
                    "plus… plus…",
                    "越……越……"
                  ],
                  [
                    "moins… moins…",
                    "越不……越不……"
                  ],
                  [
                    "plus… moins…",
                    "越……越不……"
                  ]
                ]
              }
            },
            {
              "t": "这里的 plus 怎么读",
              "b": "作「更多」讲、构成比较时，plus 读 /ply/（词尾 -s 不发音）；只有表示「加、而且」时才读 /plys/。所以这句读 /ply ʒa.pʁɑ̃/，不读 /plys/。"
            },
            {
              "t": "cette 是阴性单数的指示形容词",
              "b": "指示形容词相当于「这个/那个」，要跟名词配合：ce livre（阳性）、cet ami（阳性但元音开头）、cette langue（阴性）、ces livres（复数）。所以 langue 是阴性 → cette langue。"
            },
            {
              "t": "形容词 belle 为什么可以放在名词后面",
              "b": "法语形容词绝大多数放在名词后面：une langue belle。只有少数短小的常用词（beau、joli、grand、petit、jeune、vieux、bon、mauvais）习惯放前面，但放前面时要换形式：une belle langue。两种都对，只是位置影响强调的是「性质」还是「类别」。"
            },
            {
              "t": "apprendre（学；学会）的现在时变位",
              "conj": {
                "v": "apprendre",
                "t": "present"
              },
              "b": "和 prendre 同族，词根、变位套路完全一样：apprendre / comprendre / reprendre。"
            },
            {
              "t": "trouver（找到；觉得（trouver ça bizarre 觉得奇怪））的现在时变位",
              "conj": {
                "v": "trouver",
                "t": "present"
              },
              "b": ""
            }
          ],
